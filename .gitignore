_site/*
_site-*/*
_theme_packages/*

Thumbs.db
.DS_Store

!.gitkeep

# these files are now generated on projects that symlink to certain files in this project tree
# ref: https://github.com/ezequielv/blog-tech.git/
# ref:  .gitignore.relatedhandle.copy_deref.copy_update.end.conf
.gitignore

.rbenv-version
.rvmrc

# [ezequielv] own local symlinks/files, etc.
.local
.local[-_]*

# track 'localrc.vim' plugin-related (user) files
!.local*.vimrc

# renamed (gutentags (vim)) "exuberant ctags" output files
ctags_tags*

Gemfile.lock

.jekyll-metadata

# these 'lftp' config files should not be committed to a git repository from
# the root directory.
/lftp[-_]*.cfg*

